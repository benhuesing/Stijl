[Desktop Entry]
Name=Stijl
GenericName=Vector Graphics Editor
GenericName[de]=Vektorzeichner
GenericName[es]=Editor de gráficos vectoriales
GenericName[fr]=Éditeur de graphiques vectoriels
Comment=Draw vector graphics and save them as SVG, PDF, PNG or JPG
Comment[de]=Vektorgrafiken zeichnen und als SVG, PDF, PNG oder JPG speichern
Comment[es]=Dibuje gráficos vectoriales y guárdelos como SVG, PDF, PNG o JPG
Comment[fr]=Dessinez des graphiques vectoriels et enregistrez-les en SVG, PDF, PNG ou JPG
Exec=stijl %F
Icon=io.github.benhuesing.Stijl
Terminal=false
Type=Application
Categories=Graphics;VectorGraphics;GTK;GNOME;
Keywords=vector;svg;drawing;illustration;design;
Keywords[de]=Vektor;SVG;Zeichnen;Illustration;Grafik;Design;
Keywords[es]=vector;svg;dibujo;ilustración;diseño;gráficos;
Keywords[fr]=vectoriel;svg;dessin;illustration;design;graphisme;
MimeType=image/svg+xml;application/illustrator;application/vnd.oasis.opendocument.text;application/vnd.oasis.opendocument.text-template;
StartupNotify=true
